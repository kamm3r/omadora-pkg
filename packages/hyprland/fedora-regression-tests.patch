+    for (const auto& [_, protocol] : PROTO::outputs)
+        protocols.emplace_back(protocol);
+    for (const auto& protocol : protocols) {
+        if (protocol->m_removeTimer)
+            protocol->m_removeTimer->updateTimeout(std::chrono::nanoseconds(0));
+    }
+    g_pEventLoopManager->onTimerFire();
+}
