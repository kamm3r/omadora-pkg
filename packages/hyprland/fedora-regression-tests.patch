+
+TEST_F(COutputTest, RemovalGraceRetainsUnboundOutputForLateBind) {
+    m_protocol->remove();
+    ASSERT_TRUE(m_protocol->isDefunct());
+    ASSERT_FALSE(m_protocol->hasBoundResources());
+    EXPECT_TRUE(PROTO::outputs.contains(m_monitor->m_name));
+    g_pEventLoopManager->onTimerFire();
+    EXPECT_TRUE(PROTO::outputs.contains(m_monitor->m_name));
+    ASSERT_NO_FATAL_FAILURE(bindOutput());
+    ASSERT_NO_FATAL_FAILURE(releaseOutput(false));
+    EXPECT_TRUE(PROTO::outputs.contains(m_monitor->m_name));
+    advanceRemovalGrace();
+    EXPECT_TRUE(PROTO::outputs.empty());
+}
+
+TEST_F(COutputTest, RemovalGraceExpiryKeepsBoundOutputUntilRelease) {
+    m_protocol->remove();
+    ASSERT_NO_FATAL_FAILURE(bindOutput());
+    advanceRemovalGrace();
+    EXPECT_TRUE(PROTO::outputs.contains(m_monitor->m_name));
+    EXPECT_TRUE(m_protocol->hasBoundResources());
+    ASSERT_NO_FATAL_FAILURE(releaseOutput());
+    EXPECT_TRUE(PROTO::outputs.empty());
+}
--- /dev/null
+++ b/tests/config/shared/MonitorRuleVRR.cpp
@@ -0,0 +1,19 @@
+#include <config/shared/monitor/MonitorRule.hpp>
+#include <gtest/gtest.h>
+
+TEST(MonitorRuleVRR, ChangingOnlyVRRRequestsSoftRefresh) {
+    Config::CMonitorRule active;
+    active.m_vrr = 0;
+    auto requested = active;
+    requested.m_vrr = 1;
+    EXPECT_EQ(active.compare(requested), Config::COMPARISON_SOFT_MISMATCH);
+    EXPECT_EQ(requested.compare(active), Config::COMPARISON_SOFT_MISMATCH);
+    EXPECT_EQ(active.compare(active), Config::COMPARISON_FULL_MATCH);
+}
+
+TEST(MonitorRuleVRR, ExplicitVRRDiffersFromInheritedDefault) {
+    Config::CMonitorRule inherited;
+    auto requested = inherited;
+    requested.m_vrr = 0;
+    EXPECT_EQ(inherited.compare(requested), Config::COMPARISON_SOFT_MISMATCH);
+}
